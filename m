+	uint gamma_lut_size = 0;
 
 	if (!path)
 		return 0;
@@ -870,6 +875,12 @@ int mtk_drm_crtc_create(struct drm_device *drm_dev,
 		}
 
 		mtk_crtc->ddp_comp[i] = comp;
+
+		if (comp_id == DDP_COMPONENT_CCORR)
