+			};
+
+			mt6392_vgp2_reg: ldo-vgp2 {
+				regulator-name = "ldo-vgp2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-enable-ramp-delay = <264>;
+			};
+
+			mt6392_vcn18_reg: ldo-vcn18 {
